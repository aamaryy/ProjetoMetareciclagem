"use client"

import { useState, useEffect } from "react"
import { MapPinIcon, ZoomInIcon, ZoomOutIcon } from "lucide-react"

export default function MapComponent() {
  const [mapLoaded, setMapLoaded] = useState(false)
  const [zoomLevel, setZoomLevel] = useState(1)
  const [selectedPoint, setSelectedPoint] = useState(null)

  // Pontos de coleta em Sorocaba (coordenadas aproximadas)
  const pontosColeta = [
    { id: 1, nome: "Ecoponto Central", lat: -23.5015, lng: -47.4526 },
    { id: 2, nome: "Supermercado Eco", lat: -23.4789, lng: -47.4356 },
    { id: 3, nome: "Shopping Sorocaba", lat: -23.469, lng: -47.423 },
    { id: 4, nome: "Faculdade Tecnológica", lat: -23.512, lng: -47.465 },
    { id: 5, nome: "Parque Ambiental", lat: -23.523, lng: -47.441 },
    { id: 6, nome: "Prefeitura Municipal", lat: -23.5058, lng: -47.4525 },
    { id: 7, nome: "Projeto META - Prefeitura", lat: -23.4978, lng: -47.4482 },
    { id: 8, nome: "Escola Técnica Estadual", lat: -23.5112, lng: -47.4598 },
    { id: 9, nome: "Biblioteca Municipal", lat: -23.5067, lng: -47.4612 },
    { id: 10, nome: "Cooperativa ReciclaVida", lat: -23.4892, lng: -47.4723 },
    { id: 11, nome: "Centro Cultural Sorocaba", lat: -23.5021, lng: -47.4551 },
    { id: 12, nome: "Mercado Municipal", lat: -23.5032, lng: -47.4538 },
    { id: 13, nome: "Corezzo", lat: -23.475, lng: -47.445 },
    { id: 14, nome: "Cooperezo", lat: -23.512, lng: -47.468 },
    { id: 15, nome: "SEMA", lat: -23.504, lng: -47.456 },
  ]

  useEffect(() => {
    // Simulação de carregamento do mapa
    const timer = setTimeout(() => {
      setMapLoaded(true)
    }, 1000)

    return () => clearTimeout(timer)
  }, [])

  const handleZoomIn = () => {
    setZoomLevel((prev) => Math.min(prev + 0.2, 2))
  }

  const handleZoomOut = () => {
    setZoomLevel((prev) => Math.max(prev - 0.2, 0.6))
  }

  const handlePointClick = (point) => {
    setSelectedPoint(point)
  }

  return (
    <div className="relative h-full w-full bg-gray-100 rounded-lg overflow-hidden">
      {!mapLoaded ? (
        <div className="flex h-full w-full items-center justify-center">
          <div className="h-8 w-8 animate-spin rounded-full border-4 border-green-600 border-t-transparent"></div>
        </div>
      ) : (
        <>
          {/* Imagem de fundo simulando um mapa */}
          <div
            className="absolute inset-0 bg-[#e8f4f8]"
            style={{ transform: `scale(${zoomLevel})`, transformOrigin: "center" }}
          >
            {/* Linhas simulando ruas */}
            <div className="absolute inset-0">
              <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                <pattern id="grid" width="100" height="100" patternUnits="userSpaceOnUse">
                  <path d="M 100 0 L 0 0 0 100" fill="none" stroke="#ccc" strokeWidth="1" />
                </pattern>
                <rect width="100%" height="100%" fill="url(#grid)" />

                {/* Ruas principais */}
                <line x1="0" y1="250" x2="100%" y2="250" stroke="#aaa" strokeWidth="8" />
                <line x1="50%" y1="0" x2="50%" y2="100%" stroke="#aaa" strokeWidth="8" />
                <line x1="20%" y1="0" x2="70%" y2="100%" stroke="#aaa" strokeWidth="6" />
                <line x1="80%" y1="0" x2="30%" y2="100%" stroke="#aaa" strokeWidth="6" />

                {/* Áreas verdes */}
                <circle cx="30%" cy="30%" r="50" fill="#c8e6c9" />
                <circle cx="70%" cy="70%" r="70" fill="#c8e6c9" />
                <rect x="10%" y="60%" width="100" height="100" fill="#c8e6c9" />

                {/* Símbolos de sustentabilidade */}
                <g transform="translate(200, 150) scale(0.5)">
                  <circle cx="0" cy="0" r="40" fill="#a5d6a7" />
                  <path d="M-20,-20 L20,20 M-20,20 L20,-20" stroke="#2e7d32" strokeWidth="8" />
                </g>
                <g transform="translate(600, 350) scale(0.5)">
                  <circle cx="0" cy="0" r="40" fill="#a5d6a7" />
                  <path d="M0,-30 L26,15 L-26,15 Z" fill="#2e7d32" />
                </g>
                <g transform="translate(400, 100) scale(0.4)">
                  <circle cx="0" cy="0" r="40" fill="#a5d6a7" />
                  <path d="M-15,-15 L15,-15 L15,15 L-15,15 Z" fill="#2e7d32" />
                </g>

                {/* Ícones de reciclagem */}
                <g transform="translate(150, 400) scale(0.4)">
                  <circle cx="0" cy="0" r="50" fill="#bbdefb" />
                  <path d="M-20,-20 C-40,0 -40,40 0,40 C40,40 40,0 20,-20 Z" fill="#1976d2" />
                </g>
                <g transform="translate(700, 200) scale(0.4)">
                  <circle cx="0" cy="0" r="50" fill="#bbdefb" />
                  <path d="M-20,-20 C-40,0 -40,40 0,40 C40,40 40,0 20,-20 Z" fill="#1976d2" />
                </g>

                {/* Símbolos adicionais de sustentabilidade */}
                <g transform="translate(300, 300) scale(0.4)">
                  <circle cx="0" cy="0" r="45" fill="#c8e6c9" />
                  <path d="M0,-30 A30,30 0 0,1 26,15 A30,30 0 0,1 -26,15 Z" fill="#2e7d32" />
                </g>
                <g transform="translate(500, 200) scale(0.4)">
                  <circle cx="0" cy="0" r="45" fill="#c8e6c9" />
                  <path d="M-20,-10 L0,-30 L20,-10 L10,30 L-10,30 Z" fill="#2e7d32" />
                </g>
                <g transform="translate(250, 450) scale(0.4)">
                  <circle cx="0" cy="0" r="45" fill="#c8e6c9" />
                  <path d="M-20,0 A20,20 0 0,0 20,0 A20,20 0 0,0 -20,0" fill="#2e7d32" />
                </g>
                <g transform="translate(650, 100) scale(0.4)">
                  <circle cx="0" cy="0" r="45" fill="#c8e6c9" />
                  <path d="M-15,-15 L15,-15 L0,15 Z" fill="#2e7d32" />
                </g>
              </svg>
            </div>

            {/* Marcadores dos pontos de coleta */}
            {pontosColeta.map((ponto) => {
              // Convertendo coordenadas para posição na tela
              const x = `${((ponto.lng + 47.5) * 1000) % 100}%`
              const y = `${((ponto.lat + 23.6) * 1000) % 100}%`

              // Determinar se é um ponto de metareciclagem
              const isMetareciclagem = [7, 13, 14, 15].includes(ponto.id)
              const bgColor = isMetareciclagem ? "bg-purple-600" : "bg-green-600"
              const hoverEffect = "transition-transform hover:scale-110 cursor-pointer"

              return (
                <div
                  key={ponto.id}
                  className="absolute flex flex-col items-center"
                  style={{ left: x, top: y }}
                  onClick={() => handlePointClick(ponto)}
                >
                  <div className="group relative">
                    <div className="absolute bottom-full mb-2 w-40 -translate-x-1/2 rounded-md bg-black bg-opacity-75 p-2 text-xs text-white opacity-0 transition-opacity group-hover:opacity-100">
                      {ponto.nome}
                      {isMetareciclagem && (
                        <span className="block mt-1 text-purple-300 text-[10px]">Ponto de Metareciclagem</span>
                      )}
                    </div>
                    <div
                      className={`flex h-8 w-8 items-center justify-center rounded-full ${bgColor} text-white shadow-lg ${hoverEffect}`}
                    >
                      <MapPinIcon className="h-5 w-5" />
                    </div>
                  </div>
                </div>
              )
            })}
          </div>

          {/* Controles do mapa */}
          <div className="absolute bottom-4 right-4 flex flex-col gap-2">
            <button
              className="flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-md hover:bg-gray-100"
              onClick={handleZoomIn}
            >
              <ZoomInIcon className="h-5 w-5" />
            </button>
            <button
              className="flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-md hover:bg-gray-100"
              onClick={handleZoomOut}
            >
              <ZoomOutIcon className="h-5 w-5" />
            </button>
          </div>

          {/* Legenda do mapa */}
          <div className="absolute left-4 top-4 rounded-lg bg-white p-3 shadow-md">
            <h3 className="mb-2 text-sm font-semibold">Legenda</h3>
            <div className="space-y-2">
              <div className="flex items-center gap-2">
                <div className="flex h-6 w-6 items-center justify-center rounded-full bg-green-600 text-white">
                  <MapPinIcon className="h-4 w-4" />
                </div>
                <span className="text-xs">Ponto de coleta</span>
              </div>
              <div className="flex items-center gap-2">
                <div className="flex h-6 w-6 items-center justify-center rounded-full bg-purple-600 text-white">
                  <MapPinIcon className="h-4 w-4" />
                </div>
                <span className="text-xs">Ponto de metareciclagem</span>
              </div>
            </div>
          </div>

          {/* Informações do ponto selecionado */}
          {selectedPoint && (
            <div className="absolute bottom-4 left-4 w-64 bg-white rounded-lg shadow-md p-3">
              <h4 className="font-semibold">{selectedPoint.nome}</h4>
              <p className="text-xs text-gray-600 mt-1">Clique para ver detalhes</p>
              <button
                className="mt-2 text-xs text-green-600 hover:text-green-800"
                onClick={() => setSelectedPoint(null)}
              >
                Fechar
              </button>
            </div>
          )}
        </>
      )}
    </div>
  )
}
