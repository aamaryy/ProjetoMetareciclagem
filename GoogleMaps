"use client"

import { useState, useEffect } from "react"

export default function GoogleMapsComponent() {
  const [mapLoaded, setMapLoaded] = useState(false)

  useEffect(() => {
    // Simulação de carregamento do mapa
    const timer = setTimeout(() => {
      setMapLoaded(true)
    }, 1000)

    return () => clearTimeout(timer)
  }, [])

  return (
    <div className="relative h-full w-full rounded-lg overflow-hidden">
      {!mapLoaded ? (
        <div className="flex h-full w-full items-center justify-center">
          <div className="h-8 w-8 animate-spin rounded-full border-4 border-green-600 border-t-transparent"></div>
        </div>
      ) : (
        <div className="h-full w-full">
          <iframe
            src="https://www.google.com/maps/d/embed?mid=1Ry2KYXnzehYUFPnw-_6zMxcOPnRQnQs&ehbc=2E312F&noscroll=true"
            width="100%"
            height="100%"
            style={{ border: 0 }}
            allowFullScreen={true}
            loading="lazy"
            referrerPolicy="no-referrer-when-downgrade"
            title="Pontos de Coleta de Lixo Eletrônico em Sorocaba"
            className="absolute inset-0"
          ></iframe>

          <div className="absolute bottom-4 right-4 bg-white p-3 rounded-lg shadow-md z-10">
            <h3 className="text-sm font-semibold mb-1">Legenda</h3>
            <div className="flex items-center gap-2 text-xs">
              <div className="w-3 h-3 rounded-full bg-green-600"></div>
              <span>Pontos de coleta</span>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
